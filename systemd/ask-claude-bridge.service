[Unit]
Description=ask-claude-bridge: HTTP local (OpenAI-compatible) -> Claude Code oficial (assinatura)
After=network-online.target

[Service]
Type=simple
Environment="PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="ASK_CLAUDE_BRIDGE_MODE=edit"
ExecStart=/usr/bin/python3 %h/.local/bin/ask-claude-bridge.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
